{
  "name": "finfolk-datasets",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-data.mjs && next build",
    "test": "node --test tests/service.test.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 8786",
    "setup": "git lfs install --local && git lfs pull --include=\"data/*.json\" && npm run build",
    "start": "next start --hostname 127.0.0.1 --port 8786"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "jose": "^6.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "netlify-cli": "27.16.2",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "better-auth": "1.7.18",
    "@better-auth/core": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "zod": "4.6.7"
  }
}
